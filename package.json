{
  "name": "@schoolonchain/research-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Independent, auditable research workflow for the Knowledge Hub.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
